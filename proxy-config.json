{
  "host": "127.0.0.1",
  "port": 8787,
  "pid_file": "proxy.pid",
  "expose_canonical_models": false,
  "model_selection_file": "models.txt",
  "providers": {
    "chatgpt": {
      "enabled": true,
      "base_url": "https://chatgpt.com/backend-api/codex",
      "auth_mode": "openai_passthrough",
      "protocol": "responses",
      "discover_models": true,
      "model_prefix": "chatgpt/",
      "compat_profile": "openai",
      "metadata_profile": "openai",
      "network": "default",
      "display_name": "ChatGPT",
      "models": {}
    },
    "opencode": {
      "enabled": true,
      "base_url": "https://opencode.ai/zen/go/v1",
      "api_key_env": "OPENCODE_API_KEY",
      "auth_mode": "api_key",
      "protocol": "responses",
      "discover_models": true,
      "model_prefix": "oc/",
      "compat_profile": "deepseek",
      "metadata_profile": "generic",
      "network": "default",
      "display_name": "OC",
      "models": {},
      "model_overrides": {
        "muse-*": {
          "metadata_profile": "muse",
          "tool_schema_compat": "muse"
        }
      }
    },
    "deepseek": {
      "enabled": true,
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "auth_mode": "api_key",
      "protocol": "responses",
      "discover_models": true,
      "model_prefix": "ds/",
      "compat_profile": "deepseek",
      "metadata_profile": "deepseek",
      "network": "direct",
      "display_name": "DS",
      "models": {}
    },
    "zai": {
      "enabled": true,
      "base_url": "https://api.z.ai/api/v1",
      "api_key_env": "ZAI_API_KEY",
      "auth_mode": "api_key",
      "protocol": "responses",
      "discover_models": true,
      "model_prefix": "zai/",
      "compat_profile": "passthrough",
      "metadata_profile": "zai",
      "network": "default",
      "display_name": "ZAI",
      "models": {}
    },
    "kimi": {
      "enabled": false,
      "base_url": "https://api.moonshot.cn/v1",
      "api_key_env": "MOONSHOT_API_KEY",
      "auth_mode": "api_key",
      "protocol": "responses",
      "discover_models": true,
      "model_prefix": "kimi/",
      "compat_profile": "passthrough",
      "metadata_profile": "generic",
      "network": "default",
      "display_name": "Kimi",
      "models": {}
    }
  },
  "aliases": {},
  "compatibility_overrides": [
    {
      "provider": "cpa",
      "model_pattern": "gpt-*",
      "profile": "openai"
    },
    {
      "provider": "cpa",
      "model_pattern": "*codex*",
      "profile": "openai"
    },
    {
      "provider": "cpa",
      "model_pattern": "deepseek-*",
      "profile": "deepseek"
    }
  ]
}
