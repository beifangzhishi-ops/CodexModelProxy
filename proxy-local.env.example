# 复制本文件为 proxy-local.env（已被 Git 忽略）后按本机情况修改，用于存放机器差异配置。

# 默认不定义 PROXY_URL：自动读取当前用户的 Windows 手动系统代理，变化最多约 2 秒后生效。
# 如需固定代理，取消下一行注释并填写地址；如需强制全部默认直连，使用空值 PROXY_URL=。
# PROXY_URL=http://127.0.0.1:7890

# 可选 CLIProxyAPI 上游；CPA_BASE_URL 应为包含 /v1 的 OpenAI 兼容根地址。
# 公网 Funnel 部署：
# CPA_BASE_URL=https://cpa-node.tail7c23f0.ts.net/v1
# 同一台机器仅需本地直连时可改用：http://127.0.0.1:8317/v1
# CPA_MODELS_CACHE_TTL_SECONDS=60
# 直连上游模型白名单；无论默认使用系统代理还是固定代理，列表中的模型始终直连。
DIRECT_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-direct,deepseek-v4-pro-direct

# 监听地址：默认 127.0.0.1，只允许本机程序访问，请勿改为 0.0.0.0。
HOST=127.0.0.1

# 监听端口：默认 8787，与本机其他程序冲突时可修改，并同步修改 Codex 配置中的 base_url。
PORT=8787

# 可选历史兼容监控：默认关闭；临时排查时改为 1，完成后改回 0 并手动重启中转。
# HISTORY_MONITOR=0
# HISTORY_MONITOR_FILE=history-monitor.jsonl
